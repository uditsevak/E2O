# Copy to .env for local development. Every value has a dev default except where noted.

ENV=dev
APP_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://e2o:e2o@localhost:5432/e2o

# Required in prod (the app refuses to start with the dev defaults).
# SECRET_KEY: any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# SECRETS_ENCRYPTION_KEYS: comma-separated Fernet keys, newest first, e.g.
#   `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# SECRET_KEY=
# SECRETS_ENCRYPTION_KEYS=

# Google sign-in for app users (optional). Redirect URI: {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Blob storage: "local" (disk) or "s3" (AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/blobs
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

SYNC_INTERVAL_MINUTES=5
DEFAULT_BACKFILL_DAYS=30
